rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    // Fix: if config/admins is absent, return false (no silent admin escalation)
    function isAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/config/admins) &&
        request.auth.uid in get(/databases/$(database)/documents/config/admins).data.uids;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ── Config ───────────────────────────────────────────────────────────────
    match /config/{doc} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Course content ────────────────────────────────────────────────────────
    // Students can read; only admins can write (prevents UI-bypass mutations)
    match /courses/{courseId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── User profiles ─────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── Coach notes subcollection ─────────────────────────────────────────────
    match /users/{userId}/notes/{noteId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // ── Intake answers ────────────────────────────────────────────────────────
    // Students can only write their own intake once; immutable after submission
    match /intake_answers/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Daily check-ins ───────────────────────────────────────────────────────
    match /daily_checkins/{docId} {
      allow read: if isAuth() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ── Progress photos ───────────────────────────────────────────────────────
    match /progress_photos/{docId} {
      allow read: if isAuth() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ── Coach notes (admin only) ──────────────────────────────────────────────
    match /coach_notes/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Routines ──────────────────────────────────────────────────────────────
    match /routines/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // ── Routine check-ins (daily tracking) ────────────────────────────────────
    match /routine_checkins/{userId}/days/{day} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── Routine product reports ───────────────────────────────────────────────
    match /routine_reports/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── Nutrition config (per-student items set by coach) ─────────────────────
    match /nutrition/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // ── Nutrition check-ins (daily tracking) ─────────────────────────────────
    match /nutrition_checkins/{userId}/days/{day} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── Lesson progress ───────────────────────────────────────────────────────
    // completedLessons capped at 50 (18 lessons in protocol) to prevent abuse
    match /progress/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if (isOwner(userId) || isAdmin())
        && request.resource.data.completedLessons is list
        && request.resource.data.completedLessons.size() <= 50;
    }

    // ── Onboarding tokens ─────────────────────────────────────────────────────
    // Token is the secret (UUID v4 = 128-bit random, unguessable).
    // Only admins can create tokens; only the authenticated user who used the
    // token can mark it as used, and only if it was unused before (enforced
    // server-side). Immutable fields (createdAt, expiresAt) can't be changed.
    match /onboarding_tokens/{tokenId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['createdAt', 'expiresAt', 'used'])
        && request.resource.data.used == false;
      allow update: if isAdmin()
        || (isAuth()
          && resource.data.used == false
          && request.resource.data.used == true
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.expiresAt == resource.data.expiresAt);
      allow delete: if false;
    }

    // ── Admin product catalog ─────────────────────────────────────────────────
    match /admin_products/{productId} {
      allow read, write: if isAdmin();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
