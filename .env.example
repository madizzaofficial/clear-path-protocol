# Resend (email sending)
RESEND_API_KEY=re_...
RESEND_FROM=Protocole Clear <noreply@yourdomain.com>
# Email admin pour recevoir les notifications (bilan intake soumis, signalement produit)
ADMIN_EMAIL=admin@yourdomain.com

# Inngest (event-driven workflows)
# Get these from https://app.inngest.com → your app → Manage → Signing keys
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=signkey-prod-...

# OpenAI (AI explanation + product comparison in ingredient analyzer)
OPENAI_API_KEY=

# DeepSeek (analyse INCI des produits du catalogue — ~$0.00011 / produit)
DEEPSEEK_API_KEY=

# INCI API (barcode → product lookup, cosmetics-focused — https://inciapi.com)
# Optional: falls back to Open Beauty Facts if absent
INCI_API_KEY=

# Stripe (webhook post-paiement → génération token invitation + email)
# Récupère le signing secret dans Stripe Dashboard → Webhooks → ton endpoint
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WEBHOOK_SECRET_TEST=whsec_test_...
# "test" en dev/test, absent ou "live" en prod
STRIPE_MODE=test

# Firebase Admin SDK (webhook serveur — bypasse les règles Firestore)
# Firebase Console → Paramètres → Comptes de service → Générer clé privée
# Encode en base64 : base64 -i serviceAccount.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii4uLn0=
